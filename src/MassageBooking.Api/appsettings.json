{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=massage_booking;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "MassageBookingApi",
    "Audience": "MassageBookingApp",
    "Expiry": "60"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "MassageBooking_"
  },
  "ExpoPush": {
    "BaseUrl": "https://exp.host/--/api/v2/push/send"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
